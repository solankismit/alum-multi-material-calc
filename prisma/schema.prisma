// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  GUEST
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  name            String?
  role            Role     @default(USER)
  company         String?
  logoUrl         String?
  businessAddress String?
  businessPhone   String?
  gstNumber       String?
  quotationSeq    Int      @default(0) // atomically incremented to assign sequential quotation numbers
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  worksheets Worksheet[]
  quotations Quotation[]
  rateCard   RateCard?
}

model SectionType {
  id         String   @id @default(uuid())
  name       String   @unique
  isActive   Boolean  @default(true)
  systemType String   @default("sliding") // "sliding", "openable"
  trackTypes String[] // ["2-track", "3-track"]
  configs    String[] // ["all-glass", "glass-mosquito"]

  configurations SectionConfiguration[]
}

// Stores the specific formulas/constants for a (TrackType + Config) variation
model SectionConfiguration {
  id            String      @id @default(uuid())
  sectionTypeId String
  sectionType   SectionType @relation(fields: [sectionTypeId], references: [id], onDelete: Cascade)

  trackType     String
  configuration String // "all-glass", "glass-mosquito"

  // Formula coefficients / corrections using descriptive names
  shutterWidthDeduction   Float // correction for shutter width (was x)
  heightDeduction         Float // correction for height (was y)
  threeTrackWidthAddition Float // width adjustment for 3-track 3-glass (was z)
  glassWidthDeduction     Float // glass width deduction (was a)
  glassHeightDeduction    Float // glass height deduction (was b)
  trackRailDeduction      Float   @default(0) // width deduction for track rail
  hasTrackRail            Boolean @default(true)

  // New generic deductions for Openable windows
  outerFrameWidthDeduction  Float?
  outerFrameHeightDeduction Float?
  mullionWidthDeduction     Float?
  mullionLengthDeduction    Float?

  // Feature Flags
  separateMosquitoNet     Boolean @default(false)
  differentFrameMaterials Boolean @default(false)

  // Multipliers for Frame/Interlock calculation
  frameMultiplierW Float @default(2)
  frameMultiplierH Float @default(2)

  // Interlock count multiplier logic can be inferred or added if needed
  // For now relying on standard logic: 2-track = qty, 3-track = 3*qty (or configurable later)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionTypeId, trackType, configuration])
}

model Worksheet {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  data Json // Stores the WindowInput and Result

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations Quotation[]
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model Quotation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional — a quotation can be created directly, without a saved worksheet.
  worksheetId String?
  worksheet   Worksheet? @relation(fields: [worksheetId], references: [id], onDelete: SetNull)

  quotationNumber String?
  status          QuotationStatus @default(DRAFT)

  clientName      String?
  clientPhone     String?
  clientAddress   String?
  deliveryAddress String? // defaults to clientAddress in the UI when left blank
  customerRef     String?

  pricingData Json

  totalAmount Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One reusable rate card per user — set prices once, every quotation pulls
// from here by default instead of retyping rates each time.
model RateCard {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileRatePerFt Float @default(0) // ₹ per ft — default/fallback rate for any category without an override

  // { "frame"|"shutter"|"interlock"|"trackRail"|"mullion": ratePerFt } — per-category overrides
  profileRates Json @default("{}")

  // { "<glass type/thickness label>": ratePerSqft }
  glassRates Json @default("{}")

  // { "<hardware/accessory name>": unitRate }
  hardwareRates Json @default("{}")

  laborMode        String @default("flat") // "flat" | "percentOfMaterial" | "perSqft"
  laborDefault     Float  @default(0) // ₹ flat amount, used when laborMode = "flat"
  laborPercent     Float  @default(0) // percent of material cost, used when laborMode = "percentOfMaterial"
  laborRatePerSqft Float  @default(0) // ₹ per sq.ft of total area, used when laborMode = "perSqft"

  overheadDefault     Float @default(0)
  profitMarginDefault Float @default(0) // percent
  taxRateDefault      Float @default(0) // percent

  termsText String @default("Payment terms: 50% advance, balance upon completion.\nValid for 30 days from date of issue.")

  updatedAt DateTime @updatedAt
}
