// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  GUEST
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  name              String?
  role              Role     @default(USER)
  company           String?
  logoUrl           String?
  businessAddress   String?
  businessPhone     String?
  gstNumber         String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  quotationSeq      Int      @default(0) // atomically incremented to assign sequential quotation numbers
  invoiceSeq        Int      @default(0) // reset to 1 whenever invoiceSeqFY no longer matches the current financial year
  invoiceSeqFY      String? // e.g. "2026-27" — the financial year invoiceSeq currently counts within
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  worksheets             Worksheet[]
  quotations             Quotation[]
  customers              Customer[]
  invoices               Invoice[]
  rateCard               RateCard?
  customFieldDefinitions CustomFieldDefinition[]
}

enum CustomFieldType {
  TEXT // single-line
  TEXTAREA // multi-line
  SELECT // dropdown / list of strings
}

// A user-configurable item-spec field (e.g. "Profile Color", "Glass Spec").
// Seeded once per user with the set of fields that already had a real input
// in the app (see scripts/seed-custom-field-definitions.ts) — never all 10
// ItemSpecDetails keys, since 2 of them (profileBrand, series) never had an
// input anywhere and seeding them would silently add new fields nobody
// asked for. userId today, not organizationId — matches every other model
// in this codebase pre-SaaS-multi-tenancy (see
// PLAN-saas-multi-tenancy-foundation.md); migrates mechanically if/when
// that lands.
model CustomFieldDefinition {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key       String // stable identifier — matches historical Quotation.pricingData JSON keys for seeded fields
  label     String // display label, shown on both entry forms and the printed document
  type      CustomFieldType
  options   String[] // only meaningful when type = SELECT; a SELECT is never saved with zero options
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true) // hide from new entries without deleting — deleting the row itself is also supported (see DELETE /api/user/custom-fields/[id]) and never touches historical Quotation.pricingData

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// A saved buyer, scoped to the User (business owner) using this app — reusable
// across quotations without retyping. Quotations/invoices copy this data at
// selection time (never live-joined), so deleting a Customer never touches
// documents that already reference it (see onDelete: SetNull below).
model Customer {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  phone     String?
  address   String?
  gstNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations Quotation[]
  invoices   Invoice[]

  @@index([userId])
}

model SectionType {
  id         String   @id @default(uuid())
  name       String   @unique
  isActive   Boolean  @default(true)
  systemType String   @default("sliding") // "sliding", "openable"
  trackTypes String[] // ["2-track", "3-track"]
  configs    String[] // ["all-glass", "glass-mosquito"]

  configurations SectionConfiguration[]
}

// Stores the specific formulas/constants for a (TrackType + Config) variation
model SectionConfiguration {
  id            String      @id @default(uuid())
  sectionTypeId String
  sectionType   SectionType @relation(fields: [sectionTypeId], references: [id], onDelete: Cascade)

  trackType     String
  configuration String // "all-glass", "glass-mosquito"

  // Formula coefficients / corrections using descriptive names
  shutterWidthDeduction   Float // correction for shutter width (was x)
  heightDeduction         Float // correction for height (was y)
  threeTrackWidthAddition Float // width adjustment for 3-track 3-glass (was z)
  glassWidthDeduction     Float // glass width deduction (was a)
  glassHeightDeduction    Float // glass height deduction (was b)
  trackRailDeduction      Float   @default(0) // width deduction for track rail
  hasTrackRail            Boolean @default(true)

  // New generic deductions for Openable windows
  outerFrameWidthDeduction  Float?
  outerFrameHeightDeduction Float?
  mullionWidthDeduction     Float?
  mullionLengthDeduction    Float?

  // Feature Flags
  separateMosquitoNet     Boolean @default(false)
  differentFrameMaterials Boolean @default(false)

  // Multipliers for Frame/Interlock calculation
  frameMultiplierW Float @default(2)
  frameMultiplierH Float @default(2)

  // Interlock count multiplier logic can be inferred or added if needed
  // For now relying on standard logic: 2-track = qty, 3-track = 3*qty (or configurable later)

  // Hardware quantities per window, coupled to this (section + track-type + config) combo
  lockCount      Int @default(0)
  bearingCount   Int @default(0)
  cornerCount    Int @default(0)
  connectorCount Int @default(0)
  capCount       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionTypeId, trackType, configuration])
}

model Worksheet {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  data Json // Stores the WindowInput and Result

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations Quotation[]

  @@index([userId])
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model Quotation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional — a quotation can be created directly, without a saved worksheet.
  worksheetId String?
  worksheet   Worksheet? @relation(fields: [worksheetId], references: [id], onDelete: SetNull)

  quotationNumber String?
  status          QuotationStatus @default(DRAFT)
  // Set the first time this quotation is printed — combined with `status`,
  // this determines whether the quotation is still editable (see
  // isQuotationLocked in src/utils/quotationPricing.ts).
  printedAt       DateTime?

  // Optional link to a saved Customer — a convenience index, not the source
  // of truth. Client fields below are always plain copies (set at selection
  // time), so this quotation renders identically even after the Customer
  // record is edited or deleted (onDelete: SetNull).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  clientName      String?
  clientPhone     String?
  clientAddress   String?
  clientGstNumber String? // format-checked client-side, never blocking — see src/utils/validation.ts
  deliveryAddress String? // defaults to clientAddress in the UI when left blank
  customerRef     String?

  pricingData Json

  totalAmount Float

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([worksheetId])
  @@index([customerId])
}

// One reusable rate card per user — set prices once, every quotation pulls
// from here by default instead of retyping rates each time.
model RateCard {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileRatePerFt Float @default(0) // ₹ per ft — default/fallback rate for any category without an override

  // { "frame"|"shutter"|"interlock"|"trackRail"|"mullion": ratePerFt } — per-category overrides
  profileRates Json @default("{}")

  // { "frame"|"shutter"|"interlock"|"trackRail"|"mullion": kgPerFt } — used to derive coating weight
  profileWeightPerFt Json @default("{}")

  // { "<glass type/thickness label>": ratePerSqft }
  glassRates Json @default("{}")

  // { "<hardware/accessory name>": unitRate }
  hardwareRates Json @default("{}")

  rubberRatePerSqft     Float @default(0) // ₹ per sqft, same area as glass
  brushRatePerSqft      Float @default(0) // ₹ per sqft of total window area
  coatingRatePerKg      Float @default(0) // ₹ per kg of (post-wastage) profile weight
  coatingWastagePercent Float @default(4) // e.g. 4 => 100kg material becomes 104kg billed

  laborMode        String @default("flat") // "flat" | "percentOfMaterial" | "perSqft"
  laborDefault     Float  @default(0) // ₹ flat amount, used when laborMode = "flat"
  laborPercent     Float  @default(0) // percent of material cost, used when laborMode = "percentOfMaterial"
  laborRatePerSqft Float  @default(0) // ₹ per sq.ft of total area, used when laborMode = "perSqft"

  overheadDefault     Float @default(0)
  profitMarginDefault Float @default(0) // percent
  taxRateDefault      Float @default(0) // percent

  termsText String @default("Payment terms: 50% advance, balance upon completion.\nValid for 30 days from date of issue.")

  // { "<item/category name>": "<HSN code>" } — user-configured, no hardcoded
  // default (the plan's original guess, 70071900, was factually wrong).
  hsnCodes Json @default("{}")

  updatedAt DateTime @updatedAt
}

enum InvoiceStatus {
  DRAFT // editable, no invoiceNumber assigned yet
  ISSUED // number assigned; locked if INVOICE_LOCK_AFTER_PRINT=true
  PAID
  CANCELLED
}

model Invoice {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Both optional and independent — an Invoice is not tightly coupled to a
  // Quotation (it can be generated from one, or created standalone).
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  // Restrict is a cheap guard with no current user-facing consequence: no
  // deleteQuotation action exists anywhere in the app today. Documented for
  // when one is added, not a live behavior.

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  invoiceNumber String? // NULL until first finalize (see finalizeInvoice())
  invoicePrefix String        @default("INV") // user-configurable, so a parallel invoicing system's numbers stay visually distinguishable
  status        InvoiceStatus @default(DRAFT)
  finalizedAt   DateTime?

  // Buyer fields are plain columns, not a JSON snapshot — an Invoice often
  // has no Quotation to source them from (the standalone case), so this
  // data is first-class here either way.
  buyerName      String
  buyerAddress   String?
  buyerGstNumber String?
  buyerPhone     String?

  gstRate Float? // invoice-level default GST rate; a line's own gstRate overrides this
  taxType String @default("CGST_SGST") // "CGST_SGST" | "IGST" — one buyer/state per invoice, so this is invoice-level, not per-line (reuses the same TaxType shape as Quotation.pricingData.taxType)

  // Frozen at finalize time via getCompanySnapshot(user) — never live-joined,
  // so editing company settings later doesn't rewrite an issued invoice.
  sellerSnapshot Json?

  lines InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, invoiceNumber])
  @@index([userId])
  @@index([quotationId])
  @@index([customerId])
}

model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description   String
  quantity      Float? // e.g. 3507.29 — descriptive only; taxableAmount is still the source of truth
  unit          String? // e.g. "Sq Ft" — free text, matches whatever unit the quotation section used
  ratePerUnit   Float? // e.g. 650 — quantity * ratePerUnit informs taxableAmount but never overrides a manually entered one
  taxableAmount Float // the whole line/section price — no labor/discount/overhead breakdown per line
  hsnCode       String? // picked from RateCard.hsnCodes, or typed — never fuzzy-matched
  gstRate       Float? // per-line override; null = use Invoice.gstRate

  sortOrder Int @default(0)

  @@index([invoiceId])
}
